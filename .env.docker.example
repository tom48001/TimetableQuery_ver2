# Copy this file to .env.docker and replace every CHANGE_ME value.
# .env.docker is ignored by Git and must never be committed.

MYSQL_DATABASE=school_management
MYSQL_USER=school_app
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

DB_HOST=db
DB_PORT=3306
DB_NAME=school_management
DB_USER=school_app
DB_PASS=CHANGE_ME_DATABASE_PASSWORD

HOST=0.0.0.0
PORT=3000
CLIENT_ORIGIN=http://localhost:8080

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
SESSION_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM_SECRET

GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=gmail.com
MANAGER_EMAILS=manager@school.test
