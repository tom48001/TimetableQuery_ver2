{
  "scripts": {
    "start": "concurrently --kill-others --names server,client \"npm --prefix server start\" \"npm --prefix client start\"",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "prettier": "^3.5.2",
    "prettier-eslint": "^16.3.0",
    "vue-eslint-parser": "^8.3.0"
  }
}
