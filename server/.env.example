# Copy this file to server/.env and fill in real production values.
# Do not commit server/.env.

PORT=3000
CLIENT_ORIGIN=http://localhost:8080

GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=gmail.com
MANAGER_EMAILS=manager@school.test

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-128-character-random-hex
SESSION_SECRET=replace-with-128-character-random-hex
