PORT=3000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=school_management
DB_USER=school_app
DB_PASS=replace-with-database-password

GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=gmail.com
MANAGER_EMAILS=manager@school.test

SESSION_SECRET=replace-with-128-character-random-hex

# Development only. Production requires HTTPS CLIENT_ORIGIN and a random secret.
NODE_ENV=development
# Set only to the actual reverse proxy addresses/ranges.
# TRUST_PROXY=loopback

